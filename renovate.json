{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "skye/* on git-bringer, run by renovate-skye via dep-bringer. Same weekly window and rebase rule as lucy/renovate-config (CI load, 2026-10-09).",
  "extends": ["config:recommended", "group:allNonMajor"],
  "timezone": "UTC",
  "schedule": ["* 5-8 * * 1"],
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": { "enabled": true, "schedule": ["* 5-8 * * 1"] },
  "vulnerabilityAlerts": { "schedule": ["at any time"] },
  "osvVulnerabilityAlerts": true
}
